{
  "name": "doll-wardrobe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "NEXT_PUBLIC_WORKERS_URL='' next dev --experimental-https",
    "dev:workers": "wrangler dev",
    "build": "next build",
    "build:workers": "wrangler deploy --dry-run",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.workers.json && tsc --noEmit -p tsconfig.workers-test.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "oxlint src/ workers/ && eslint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "test:workers:watch": "vitest --config vitest.config.workers.ts",
    "deploy:workers": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply doll-wardrobe-db",
    "db:migrate:local": "wrangler d1 migrations apply doll-wardrobe-db --local",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --namespace es",
    "i18n:check": "bash scripts/i18n-check.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lp:screenshots": "tsx scripts/capture-lp-screenshots.ts",
    "precheck": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm i18n:check",
    "precheck:full": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm i18n:check && pnpm test"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.9",
    "@hono/trpc-server": "^0.4.2",
    "@lingui/core": "^5.9.3",
    "@lingui/react": "^5.9.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sentry/nextjs": "^10.43.0",
    "@serwist/turbopack": "^9.5.6",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@trpc/client": "^11.1.0",
    "@trpc/server": "^11.1.0",
    "better-auth": "^1.6.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "esbuild": "^0.27.4",
    "hono": "^4.7.7",
    "jotai": "^2.12.3",
    "jotai-family": "^1.0.1",
    "jotai-trpc": "^0.7.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serwist": "^9.5.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20250410.0",
    "@eslint/js": "^9.25.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.3",
    "@lingui/cli": "^5.9.3",
    "@lingui/format-po": "^5.9.3",
    "@mswjs/data": "^0.16.2",
    "@opennextjs/cloudflare": "^1.17.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-macros": "^3.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.25.0",
    "eslint-config-love": "^151.0.0",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^17.4.6",
    "miniflare": "^4.20260312.0",
    "msw": "^2.8.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.4",
    "tsc-files": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2",
    "wrangler": "^4.65.0"
  }
}
